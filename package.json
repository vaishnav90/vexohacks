{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "say": "tsx scripts/say.ts",
    "voices": "tsx scripts/voices.ts",
    "kit": "test -d vexo-open-kit && git -C vexo-open-kit pull --ff-only || git clone --depth 1 https://github.com/VexoAI-Org/vexo-open-kit.git vexo-open-kit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.20.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
