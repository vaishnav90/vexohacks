#!/bin/sh
# Blocks commits that contain env files or anything that looks like an API key.
fail=0

# 1. env files (template allowed)
envs=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$')
if [ -n "$envs" ]; then
  echo "BLOCKED: env file staged:"; echo "$envs"; fail=1
fi

# 2. key-shaped strings in added lines
pattern='(sk-api-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|(API_KEY|SECRET|TOKEN)[A-Z_]*[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9_./+-]{20,})'
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  if git diff --cached -U0 -- "$f" | grep -E '^\+[^+]' | grep -qE "$pattern"; then
    echo "BLOCKED: possible API key in $f (value not shown)"; fail=1
  fi
done

if [ $fail -ne 0 ]; then
  echo "Remove the secret (keep keys in .env). If this is a false positive: git commit --no-verify"
  exit 1
fi
