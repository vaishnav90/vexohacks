# MiniMax (https://platform.minimax.io > Account Management > API Keys)
MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=English_expressive_narrator
# Hard cap on characters sent to MiniMax (cache hits don't count). 150000 chars ~= $9 at $60/M.
MINIMAX_CHAR_BUDGET=150000
# Deepgram speech-to-text for the band's microphone (key from the event organisers).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# OpenAI turns finished sentences into crew actions (key from the event organisers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PORT=3000
