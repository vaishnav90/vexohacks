# MiniMax (https://platform.minimax.io > Account Management > API Keys)
MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=English_expressive_narrator
# Hard cap on characters sent to MiniMax (cache hits don't count). 150000 chars ~= $9 at $60/M.
MINIMAX_CHAR_BUDGET=150000
PORT=3000
# Crew member name → band number mapping (JSON). Keep keys lowercase.
BAND_CREW={"vaishnav":26}

# Deepgram — speech-to-text (band mic + laptop mic → transcript)
DEEPGRAM_API_KEY=

# OpenAI — intent parsing (transcript → band command)
OPENAI_API_KEY=
# Use gpt-4o-mini for the event; gpt-6-luna is the kit default but not a real model.
OPENAI_MODEL=gpt-4o-mini
